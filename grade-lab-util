#!/usr/bin/env python3

import re
from gradelib import *

r = Runner(save("xv6.out"))

@test(3, "sleep")
def test_sleep():
    r.run_qemu(shell_script([
        'sleep 10'
    ]))
    r.match(no=["exec .* failed", "$ sleep\n$"])

