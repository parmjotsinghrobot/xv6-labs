# ──────────────────────────────────────────────────────────────
# Part 2 — Priority Scheduler
# All tests delegate to user/schedtest.c, must add $U/_schedtest to UPROGS in Makefile.
# Run individually with:  ./grade-lab-util schedule
# ──────────────────────────────────────────────────────────────

# ── Test 1: getpinfo() ────────────────────────────────────────
# T3: getpinfo(&st) returns 0 (valid pointer)
# T4: getpinfo(0)   returns -1 (null pointer)
# T5: new process has default priority 1

@test(5, "schedule, getpinfo")
def test_schedule_getpinfo():
    r.run_qemu(shell_script([
        'schedtest',
        'echo DONE',
    ]))
    r.match(
        r'^PASS: T3',
        r'^PASS: T4',
        r'^PASS: T5',
        r'^DONE$',
        no=['exec schedtest failed', 'panic']
    )

# ── Test 2: setpri() ──────────────────────────────────────────
# T1a: setpri(1) returns 0
# T1b: setpri(2) returns 0
# T2a: setpri(0)  returns -1
# T2b: setpri(3)  returns -1
# T2c: setpri(-1) returns -1
# T8a: setpri(2) is reflected in getpinfo output
# T8b: setpri(1) lowers priority back to 1

@test(10, "schedule, setpri")
def test_schedule_setpri():
    r.run_qemu(shell_script([
        'schedtest',
        'echo DONE',
    ]))
    r.match(
        r'^PASS: T1a',
        r'^PASS: T1b',
        r'^PASS: T2a',
        r'^PASS: T2b',
        r'^PASS: T2c',
        r'^PASS: T8a',
        r'^PASS: T8b',
        r'^DONE$',
        no=['exec schedtest failed', 'panic',
            'FAIL: T1', 'FAIL: T2', 'FAIL: T8']
    )

# ── Test 3: scheduler priority order and tick accounting ──────
# T6: high-priority child (pri=2) finishes before low-priority child (pri=1)
# T7a: ticks[2] increases when process runs at pri=2
# T7b: ticks[1] does not increase while process is at pri=2

@test(10, "schedule, priority scheduler")
def test_schedule_priority():
    r.run_qemu(shell_script([
        'schedtest',
        'echo DONE',
    ]), timeout=45)
    r.match(
        r'^PASS: T6',
        r'^PASS: T7a',
        r'^PASS: T7b',
        r'^DONE$',
        no=['exec schedtest failed', 'panic',
            'FAIL: T6', 'FAIL: T7']
    )

